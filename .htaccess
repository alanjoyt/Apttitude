# Apttitudee Root .htaccess for Apache / InfinityFree
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Strictly block access to hidden files and directories (dotfiles e.g. .git, .env)
    RewriteRule (^|/)\. - [F,L]

    # 2. Strictly block direct access to internal server directories (allow migration runner)
    RewriteCond %{REQUEST_URI} !^.*/scripts/migrate_ai_ts\.php$
    RewriteRule ^(app|config|database|backups|migrations|scratch|scripts|tests|deploy)(/|$) - [F,L]

    # Route sitemap.xml dynamically through sitemap.php
    RewriteRule ^sitemap\.xml$ public/sitemap.php [L]

    # Prevent rewriting if already in public folder
    RewriteCond %{REQUEST_URI} !^/public/
    # If the file or directory does not exist in root, pass to public
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block direct access to sensitive file extensions (Apache 2.2 and 2.4 compatible)
<FilesMatch "\.(env|sql|log|bak|ini|sh|py|bat|cmd|lock|dist|backup|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Gzip / Brotli Compression for Lightning Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching Headers (Leverage Browser Cache)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"
    
    # CSS & JavaScript: 1 Month (cache busted via ?v=filemtime)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # Images & SVGs: 1 Month
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Web Fonts: 1 Year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Security & Performance Headers
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Static Assets Cache-Control
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2|woff)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

# Prevent directory listings
Options -Indexes

